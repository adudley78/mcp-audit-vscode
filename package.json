{
  "name": "mcp-audit-vscode",
  "displayName": "Credenzo",
  "description": "Credenzo (formerly mcp-audit): inline security diagnostics for MCP server configuration files",
  "version": "0.3.0",
  "publisher": "mcp-audit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adudley78/mcp-audit-vscode"
  },
  "homepage": "https://credenzo.io",
  "bugs": {
    "url": "https://github.com/adudley78/mcp-audit-vscode/issues"
  },
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Linters",
    "Security"
  ],
  "keywords": [
    "mcp",
    "security",
    "mcp-audit",
    "model-context-protocol",
    "cursor",
    "claude",
    "linter",
    "diagnostics",
    "vulnerability",
    "credenzo"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Credenzo starts a program on your machine to scan the open file. It does not run in a workspace that you do not trust."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mcp-audit.scanCurrentFile",
        "title": "Credenzo: Scan current file"
      },
      {
        "command": "mcp-audit.scanWorkspace",
        "title": "Credenzo: Scan workspace"
      },
      {
        "command": "mcp-audit.fixCurrentFile",
        "title": "Credenzo: Fix current file"
      }
    ],
    "configuration": {
      "title": "Credenzo",
      "properties": {
        "mcp-audit.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the credenzo binary (or to mcp-audit, its old name). Leave empty to auto-detect from PATH and common install locations. Set it in your user settings: a workspace can not set it."
        },
        "mcp-audit.severityThreshold": {
          "type": "string",
          "default": "info",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "enumDescriptions": [
            "Show all findings (INFO and above)",
            "Show LOW and above",
            "Show MEDIUM and above",
            "Show HIGH and above",
            "Show CRITICAL only"
          ],
          "description": "Minimum severity level to report as diagnostics."
        },
        "mcp-audit.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run Credenzo when an MCP config file is saved."
        },
        "mcp-audit.runOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run Credenzo when an MCP config file is opened."
        },
        "mcp-audit.verdict.online": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Pass --online to credenzo vet for live registry lookups. Off by default (uses the bundled registry snapshot). Requires a release that has the vet command. Set it in your user settings: a workspace can not turn network lookups on."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-tests && npm run build",
    "lint": "eslint src --ext ts",
    "test": "node ./out-test/test/runTest.js",
    "release:local": "bash scripts/release-local.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.6.6",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "mocha": "^12.0.3",
    "sinon": "^17.0.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
